#==============================================================================
# .gitattributes
#------------------------------------------------------------------------------
# PURPOSE
#   Git behavior for K-FRTB-SA: line endings, binary handling, diff and merge
#   behavior, GitHub language reporting and source archives.
#
# POLICY
#   - Exported VBA source (.bas modules, and .cls and .frm if the project
#     adds class or form modules) is normalized in Git and checked out as
#     CRLF, as the VBE imports and exports it. A form's .frx companion is
#     binary.
#   - The PowerShell scripts and cmd launchers for Windows are checked out as
#     CRLF; every other text file as LF.
#   - The workbook template, built workbooks, images and archives are binary:
#     no text normalization and no line-based merges.
#   - GitHub Linguist reports the modules as VBA.
#
# PLACEMENT
#   Keep this file at the repository root. Custom [attr] macros are honored only
#   in a top-level attributes file.
#
# POLICY CHANGES
#   Attribute changes do not rewrite existing blobs automatically. Inspect any
#   normalization separately:
#
#       git add --renormalize --dry-run .
#       git add --renormalize .
#       git diff --cached --check
#
#   Commit a required normalization as its own mechanical change.
#
# VBA DIFF DRIVER
#   The vba driver below is harmless without local configuration. For procedure
#   names in diff hunk headers, configure each clone once:
#
#       git config diff.vba.xfuncname \
#         "^([ \t]*(Public|Private|Friend)?[ \t]*(Static[ \t]+)?(Sub|Function|Property[ \t]+(Get|Let|Set))[ \t]+[A-Za-z_].*)$"
#
#   The outer capture group is intentional: it returns the complete declaration
#   rather than only a visibility keyword.
#
# ENCODING
#   The VBE exports with the Windows code page. tools/vba_lint.py keeps the
#   modules ASCII, so no working-tree-encoding is needed.
#==============================================================================


#------------------------------------------------------------------------------
# REUSABLE ATTRIBUTE POLICIES
#------------------------------------------------------------------------------
[attr]vba-source    text eol=crlf diff=vba linguist-language=VBA
[attr]vba-form-bin  binary merge=binary linguist-generated
[attr]office-doc    binary merge=binary -linguist-detectable
[attr]opaque        binary merge=binary


#------------------------------------------------------------------------------
# DETERMINISTIC DEFAULT
#------------------------------------------------------------------------------
# Normalize detected text to LF in the index and use LF in the working tree.
# The VBA and Windows script rules below override the working-tree EOL.
* text=auto eol=lf


#------------------------------------------------------------------------------
# EXPORTED VBA SOURCE
#------------------------------------------------------------------------------
# docs/REPOSITORY_STRUCTURE.md: commit exported .bas, .cls and .frm files and
# keep each .frx beside its .frm.
*.bas   vba-source
*.cls   vba-source
*.frm   vba-source
*.frx   vba-form-bin


#------------------------------------------------------------------------------
# WINDOWS SCRIPTS
#------------------------------------------------------------------------------
# tools/Build-Workbook.ps1, Sync-FRTB-VBA.ps1, Export-FRTB-VBA.ps1 and the
# .cmd launchers run in Windows PowerShell and cmd.exe.
*.cmd   text eol=crlf
*.ps1   text eol=crlf


#------------------------------------------------------------------------------
# PYTHON AND NODE TOOLING
#------------------------------------------------------------------------------
*.py    text eol=lf
*.mjs   text eol=lf


#------------------------------------------------------------------------------
# DOCUMENTATION AND STRUCTURED CONFIGURATION
#------------------------------------------------------------------------------
*.md            text eol=lf
*.txt           text eol=lf
*.yml           text eol=lf
*.json          text eol=lf
# Traffic history data on the traffic-history branch (docs/TRAFFIC_HISTORY.md).
*.csv           text eol=lf

.editorconfig   text eol=lf
.gitattributes  text eol=lf
.gitignore      text eol=lf
LICENSE         text eol=lf


#------------------------------------------------------------------------------
# WORKBOOKS
#------------------------------------------------------------------------------
# The template (src/workbook/FRTB_Template.xlsx) and any built workbook are
# ZIP containers: keep them opaque to text conversion and line-based merges.
*.xlsx  office-doc
*.xlsm  office-doc

# Excel lock files: normally ignored, classified defensively if one reaches
# the index.
~$*     opaque


#------------------------------------------------------------------------------
# IMAGES AND ARCHIVES
#------------------------------------------------------------------------------
# The social preview and screenshots in docs/assets; zipped evidence bundles.
*.png   opaque
*.jpg   opaque
*.jpeg  opaque
*.zip   opaque


#------------------------------------------------------------------------------
# ARCHIVE HYGIENE
#------------------------------------------------------------------------------
# These rules apply to git archive and archive producers that honor Git
# attributes. Repository plumbing is not part of a consumable source package.
.gitattributes  export-ignore
.gitignore      export-ignore
.editorconfig   export-ignore
.github         export-ignore
.github/**      export-ignore
