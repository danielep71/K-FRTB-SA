#==============================================================================
# .gitignore
#------------------------------------------------------------------------------
# PURPOSE
#   Keep K-FRTB-SA source-first and safe to clone: the VBA modules, the
#   macro-free template, the tools, the tests and the documentation are
#   tracked; built workbooks, Office lock files, local environments, caches
#   and secrets are not.
#
# REPOSITORY POLICY
#   - The exported VBA modules of src/modules and tests/modules are the source
#     of the workbook code.
#   - The only tracked Office package is src/workbook/FRTB_Template.xlsx.
#     Built workbooks (dist/K-FRTB-SA.xlsm), the safety copies of
#     tools/Sync-FRTB-VBA.ps1 and any other workbook stay out.
#   - Excel evidence bundles are kept outside the checkout; only their dated
#     Markdown records go under docs/evidence/ (docs/EXCEL_EVIDENCE.md).
#
# SAFETY RULE
#   Never add broad rules for the VBA modules, documentation, tools, tests or
#   .github. An exception for another Office package must use its exact
#   rooted path.
#==============================================================================


#------------------------------------------------------------------------------
# OFFICE TEMPORARY / LOCK / RECOVERY FILES
#------------------------------------------------------------------------------
# Excel lock files (~$*), LibreOffice lock files and backups.
~$*
.~lock.*#

*.tmp
*.temp
*.bak
*.backup
*.xlk


#------------------------------------------------------------------------------
# WORKBOOKS
#------------------------------------------------------------------------------
# A workbook saved anywhere in the tree is build output, a local copy or a
# safety copy, never source.
*.xls
*.xlsx
*.xlsm
*.xlsb
*.xlt
*.xltx
*.xltm
*.xla
*.xlam
*.xll
*.xlw

# The macro-free template that builds start from (src/workbook/README.md).
!/src/workbook/FRTB_Template.xlsx


#------------------------------------------------------------------------------
# BUILD OUTPUT
#------------------------------------------------------------------------------
# tools/Build-Workbook.ps1 writes dist/K-FRTB-SA.xlsm by default.
/dist/


#------------------------------------------------------------------------------
# LOCAL TEST OUTPUT
#------------------------------------------------------------------------------
.pytest_cache/


#------------------------------------------------------------------------------
# LOCAL TEMPORARY DIRECTORIES
#------------------------------------------------------------------------------
/temp/
/tmp/
/.cache/


#------------------------------------------------------------------------------
# WINDOWS FILE-SYSTEM / SHELL METADATA
#------------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
System Volume Information/
*.stackdump

# Reserved-name artifact occasionally created by shell redirection mistakes.
nul


#------------------------------------------------------------------------------
# MACOS / NETWORK / UNIX METADATA
#------------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Trashes
.Spotlight-V100
.fseventsd

.directory
.fuse_hidden*
.nfs*


#------------------------------------------------------------------------------
# EDITOR / IDE STATE
#------------------------------------------------------------------------------
# Project-wide configuration belongs in the repository (.editorconfig);
# personal workspaces do not.
.vscode/
.idea/
.vs/
.history/
.fleet/

*.code-workspace
*.suo
*.user
*.swp
*.swo
*~

*.nppBackup
session.xml


#------------------------------------------------------------------------------
# MERGE / PATCH / CONFLICT ARTIFACTS
#------------------------------------------------------------------------------
*.orig
*.rej
*.patch.tmp


#------------------------------------------------------------------------------
# LOGS / CRASH DUMPS
#------------------------------------------------------------------------------
# Build, sync and comparison logs belong in the evidence bundle, not here.
*.log
*.dmp
*.dump


#------------------------------------------------------------------------------
# LOCAL ENVIRONMENT / SECRET / SIGNING MATERIAL
#------------------------------------------------------------------------------
# Sanitized examples remain trackable.
.env
.env.*
!.env.example

*.pfx
*.p12
*.pvk
*.key
*.pem


#------------------------------------------------------------------------------
# PYTHON CACHE / LOCAL ENVIRONMENTS
#------------------------------------------------------------------------------
# tests/requirements.txt and .github/requirements.txt remain trackable.
__pycache__/
*.py[cod]

.mypy_cache/
.ruff_cache/

# .venv-ci/ is the environment of the Repository integrity workflow.
.venv/
.venv-ci/
venv/


#------------------------------------------------------------------------------
# NODE
#------------------------------------------------------------------------------
# The label scripts in .github/scripts use only Node built-in modules.
node_modules/
