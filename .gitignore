#==============================================================================
# K-FRTB-SA .gitignore
#------------------------------------------------------------------------------
# PURPOSE
#   Keep the repository source-first, reviewable, reproducible, and safe to
#   clone. Ignore workstation state, generated output, secrets, caches, and
#   unintended Office packages while preserving authoritative source and
#   repository evidence.
#
# REPOSITORY POLICY
#   - The exported VBA modules of src/modules and tests/modules are the source
#     of the workbook code, with any UserForm companions.
#   - Workbooks, Access databases and macro-enabled Office files are ignored
#     unless an exact path is approved. The only tracked Office package is
#     src/workbook/FRTB_Template.xlsx.
#   - Excel evidence bundles are kept outside the checkout; only their dated
#     Markdown records go under docs/evidence/ (docs/EXCEL_EVIDENCE.md).
#   - Repository configuration, documentation, tests, tools, and visual assets are source.
#   - Python and Node development caches are excluded without hiding manifests.
#
# SAFETY RULE
#   Never add broad rules for exported VBA source, documentation, repository
#   automation, or evidence directories. Exceptions for intentional Office
#   packages must use exact rooted paths.
#==============================================================================


#------------------------------------------------------------------------------
# MICROSOFT OFFICE TEMPORARY / LOCK / RECOVERY FILES
#------------------------------------------------------------------------------
~$*
.~lock.*#
*.laccdb
*.ldb

*.tmp
*.temp
*.bak
*.backup
*.xlk
*.asd
*.wbk


#------------------------------------------------------------------------------
# GENERATED OFFICE PACKAGES
#------------------------------------------------------------------------------
# Workbooks, Access databases and macro-enabled Word and PowerPoint files are
# generated or release artifacts by default. These global
# rules prevent an accidental workbook saved anywhere in the tree from becoming
# source. Re-include an intentional package only by its exact rooted path.
*.xls
*.xlsx
*.xlsm
*.xlsb
*.xlt
*.xltx
*.xltm
*.xla
*.xlam
*.xll
*.xlw

*.docm
*.dotm
*.pptm
*.potm
*.ppsm
*.accdb
*.accde
*.accdr
*.mdb
*.mde
*.ade

# The only exception is the macro-free template that builds start from
# (src/workbook/README.md), by its exact rooted path. Approve any other only
# the same way, in the issue that introduces it.
!/src/workbook/FRTB_Template.xlsx
#
# Built workbooks (dist/K-FRTB-SA.xlsm by default) and the safety copies of
# tools/Sync-FRTB-VBA.ps1 are never re-included.


#------------------------------------------------------------------------------
# RELEASE / BUILD STAGING
#------------------------------------------------------------------------------
# tools/Build-Workbook.ps1 writes dist/K-FRTB-SA.xlsm by default; build/ and
# release-assets/ hold local packages (docs/REPOSITORY_STRUCTURE.md). Root
# anchoring prevents a generated-directory name from hiding an authoritative
# nested source or evidence directory.
/release-assets/
/build/
/out/
/output/
/outputs/
/dist/


#------------------------------------------------------------------------------
# LOCAL TEST / CERTIFICATION OUTPUT
#------------------------------------------------------------------------------
# test-results/ receives the evidence validator reports
# (docs/EXCEL_EVIDENCE.md) and the label workflow outputs.
/test-output/
/test-results/
/coverage/
/htmlcov/

.coverage
.coverage.*
coverage.xml

.pytest_cache/
.hypothesis/
.tox/
.nox/


#------------------------------------------------------------------------------
# LOCAL TEMPORARY DIRECTORIES
#------------------------------------------------------------------------------
/temp/
/tmp/
/.cache/


#------------------------------------------------------------------------------
# WINDOWS FILE-SYSTEM / SHELL METADATA
#------------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
System Volume Information/
*.stackdump

# Reserved-name artifact occasionally created by shell redirection mistakes.
nul


#------------------------------------------------------------------------------
# MACOS / NETWORK / UNIX METADATA
#------------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
# A custom folder icon is a file named Icon plus a carriage return.
Icon[[:cntrl:]]
._*
.Trashes
.Spotlight-V100
.fseventsd

.directory
.fuse_hidden*
.nfs*


#------------------------------------------------------------------------------
# EDITOR / IDE STATE
#------------------------------------------------------------------------------
# Project-wide configuration belongs in the repository; personal workspaces do
# not. Re-include a specific shared editor file explicitly if one is introduced.
.vscode/
.idea/
.vs/
.history/
.fleet/

*.code-workspace
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~

*.nppBackup
# Notepad++ session file, rooted so that a fixture of that name stays visible.
/session.xml

# Local folders of editor assistants.
.cursor/
.aider*
.continue/



#------------------------------------------------------------------------------
# MERGE / PATCH / CONFLICT ARTIFACTS
#------------------------------------------------------------------------------
*.orig
*.rej
*.patch.tmp


#------------------------------------------------------------------------------
# LOGS / CRASH DUMPS
#------------------------------------------------------------------------------
*.log
*.dmp
*.dump


#------------------------------------------------------------------------------
# LOCAL ENVIRONMENT / SECRET / SIGNING MATERIAL
#------------------------------------------------------------------------------
# Sanitized examples remain trackable.
.env
.env.*
!.env.example

*.pfx
*.p12
*.pvk
*.key
*.pem


#------------------------------------------------------------------------------
# PYTHON CACHE / LOCAL ENVIRONMENTS
#------------------------------------------------------------------------------
# Source, manifests, lock files, and requirements remain trackable.
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
pip-wheel-metadata/

.mypy_cache/
.pyright/
.ruff_cache/
.ipynb_checkpoints/

# .venv-ci/ is the environment of the Repository integrity workflow.
.venv/
.venv-ci/
venv/


#------------------------------------------------------------------------------
# NODE / JAVASCRIPT LOCAL DEPENDENCIES
#------------------------------------------------------------------------------
# Package manifests and lock files remain trackable. Only installed dependencies,
# machine caches, and diagnostic logs are ignored.
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.yarn/build-state.yml

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


#------------------------------------------------------------------------------
# AUTHORITATIVE CONTENT THAT MUST REMAIN TRACKABLE
#------------------------------------------------------------------------------
# These are documentation guardrails, not negation rules:
#   *.bas, *.cls, *.frm, *.frx, *.xml
#   src/**, tests/**, tools/**, docs/**, assets/**, .github/**
#   a .frx beside its .frm; index.html and .nojekyll for the web page
#   *.md, *.txt, *.yml, *.yaml, *.json, *.csv
#   .editorconfig, .gitattributes, .gitignore
#
# Do not ignore exported VBA extensions or the source, test, tool,
# documentation or .github directories.
#==============================================================================
