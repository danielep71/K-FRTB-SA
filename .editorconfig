#==============================================================================
# .editorconfig
#------------------------------------------------------------------------------
# PURPOSE
#   Editing baseline for K-FRTB-SA: the exported VBA modules of src/modules
#   and tests/modules, the Python tools and tests, the PowerShell and cmd
#   launchers for Windows, the GitHub configuration and the documentation.
#
# POLICY
#   - Exported VBA source (.bas modules, and .cls and .frm if the project
#     adds class or form modules), PowerShell scripts and cmd launchers use
#     CRLF; every other text file uses LF.
#   - VBA and Python use 4-space indentation; YAML, JSON and JavaScript use 2.
#   - Trailing whitespace is removed except in Markdown, where two trailing
#     spaces can mark an explicit line break.
#   - The VBA encoding is not forced: the VBE exports with the Windows code
#     page, and tools/vba_lint.py keeps the modules ASCII.
#
# RELATIONSHIP WITH .gitattributes
#   .editorconfig controls how supporting editors create and save working-tree
#   files. .gitattributes remains authoritative for Git normalization, binary
#   classification, diff behavior, Linguist and release archives.
#==============================================================================

root = true


#------------------------------------------------------------------------------
# DEFAULT TEXT POLICY
#------------------------------------------------------------------------------
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
tab_width = 4


#------------------------------------------------------------------------------
# EXPORTED VBA SOURCE
#------------------------------------------------------------------------------
# Do not set charset here: preserve the VBE/system-code-page export contract.
[*.{bas,cls,frm}]
end_of_line = crlf


#------------------------------------------------------------------------------
# PYTHON TOOLS AND TESTS
#------------------------------------------------------------------------------
[*.py]
charset = utf-8


#------------------------------------------------------------------------------
# LABEL SCRIPTS (NODE)
#------------------------------------------------------------------------------
[*.mjs]
charset = utf-8
indent_size = 2
tab_width = 2


#------------------------------------------------------------------------------
# GITHUB AND STRUCTURED CONFIGURATION
#------------------------------------------------------------------------------
[*.{yml,json}]
charset = utf-8
indent_size = 2
tab_width = 2


#------------------------------------------------------------------------------
# DOCUMENTATION AND ASSETS
#------------------------------------------------------------------------------
[*.md]
charset = utf-8
# Preserve intentional Markdown hard line breaks.
trim_trailing_whitespace = false

[{*.txt,*.html,LICENSE}]
charset = utf-8


#------------------------------------------------------------------------------
# WINDOWS SCRIPTS
#------------------------------------------------------------------------------
# Do not force an encoding: Windows PowerShell 5.1 and cmd.exe read these
# files with the system code page; they are kept ASCII.
[*.{cmd,ps1}]
end_of_line = crlf


#------------------------------------------------------------------------------
# REPOSITORY CONTROL FILES
#------------------------------------------------------------------------------
[{.editorconfig,.gitattributes,.gitignore}]
charset = utf-8
